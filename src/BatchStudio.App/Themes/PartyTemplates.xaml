<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BatchStudio.App.ViewModels"
                    xmlns:svc="clr-namespace:BatchStudio.App.Services">
    <BooleanToVisibilityConverter x:Key="BankBoolToVis" />
    <svc:InverseBoolToVisibilityConverter x:Key="BankInverseBoolToVis" />
    <svc:BankBadgeConverter x:Key="BankBadge" />

    <!-- number of bank accounts next to a supplier's name (2 and more); display only -->
    <Style x:Key="BankBadgeBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
        <Setter Property="ToolTip" Value="{DynamicResource Bank.BadgeTip}" />
    </Style>


    <!-- a supplier's bank accounts: Banking Details, Banking Details 2, 3 ... (the radio button = the account printed on invoices).
         Every account has its own arrow (open / close just that account) and "+" (a new account at the bottom). -->
    <DataTemplate DataType="{x:Type vm:BankGroupViewModel}">
        <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BankAccountViewModel}">
                    <StackPanel Margin="0,0,6,12">
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border CornerRadius="9" Padding="8,1" Margin="0,0,4,0" VerticalAlignment="Center" Background="{DynamicResource BrandSoftBrush}"
                                        ToolTip="{Binding DataContext.DefaultText, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsFirst}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.HasMany, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DataContext.CountText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="11"
                                               Foreground="{DynamicResource BrandBrush}" FontWeight="SemiBold" />
                                </Border>
                                <!-- delete (accounts 2, 3 ...), arrow (this account), + (new account at the bottom) -->
                                <Button Padding="7,3" MinHeight="0" MinWidth="0" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False"
                                        ToolTip="{DynamicResource Bank.Remove}" Command="{Binding RemoveCommand}"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BankBoolToVis}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11" />
                                </Button>
                                <Button Padding="7,3" MinHeight="0" MinWidth="0" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False"
                                        ToolTip="{DynamicResource Bank.Toggle}" Command="{Binding ToggleCommand}">
                                    <TextBlock FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE70E;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                        <Setter Property="Text" Value="&#xE70D;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Padding="7,3" MinHeight="0" MinWidth="0" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False"
                                        ToolTip="{DynamicResource Bank.Add}" Command="{Binding AddCommand}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" />
                                </Button>
                            </StackPanel>
                            <RadioButton IsChecked="{Binding IsDefault}" MinWidth="0" Margin="0,0,2,0" VerticalAlignment="Center" Focusable="False"
                                         ToolTip="{DynamicResource Bank.UseOnInvoice}"
                                         Visibility="{Binding DataContext.HasMany, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BankBoolToVis}}" />
                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="11,9,11,9" AcceptsReturn="True"
                                 MaxHeight="260" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Visibility="{Binding IsCollapsed, Converter={StaticResource BankInverseBoolToVis}}" />
                        <!-- closed: one line; a click opens it -->
                        <Border CornerRadius="4" Padding="11,9" Cursor="Hand" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding IsCollapsed, Converter={StaticResource BankBoolToVis}}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                            </Border.InputBindings>
                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>
</ResourceDictionary>
