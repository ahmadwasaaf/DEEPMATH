<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BatchStudio</AssemblyName>
    <RootNamespace>BatchStudio.App</RootNamespace>
    <!-- WPF0001: built-in Fluent theme (ThemeMode) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\deepmath.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\deepmath.ico" />
    <Resource Include="Assets\deepmath.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BatchStudio.Core\BatchStudio.Core.csproj" />
  </ItemGroup>
</Project>
