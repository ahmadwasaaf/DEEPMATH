<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection: Windows notifications (new emails) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>BatchStudio</AssemblyName>
    <RootNamespace>BatchStudio.App</RootNamespace>
    <!-- WPF0001: built-in Fluent theme (ThemeMode) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\deepmath.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\deepmath.ico" />
    <Resource Include="Assets\deepmath.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BatchStudio.Core\BatchStudio.Core.csproj" />
  </ItemGroup>
</Project>
