<Window x:Class="BatchStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BatchStudio.App.ViewModels"
        xmlns:views="clr-namespace:BatchStudio.App.Views"
        xmlns:svc="clr-namespace:BatchStudio.App.Services"
        xmlns:ctl="clr-namespace:BatchStudio.App.Controls"
        Title="{DynamicResource App.Title}"
        Icon="pack://application:,,,/BatchStudio;component/Assets/deepmath.ico"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataSetViewModel}"><views:DataSetView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplatesViewModel}"><views:TemplatesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EntitySetupViewModel}"><views:EntitySetupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewInvoiceViewModel}"><views:NewInvoiceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompanyReportViewModel}"><views:CompanyReportView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MassInvoiceViewModel}"><views:MassInvoiceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BankAccountsViewModel}"><views:BankAccountsView /></DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorAltBrush}" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,16">
                    <!-- DEEPMATH brand: gradient D mark + name + tagline -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20" FlowDirection="LeftToRight">
                        <Image Source="pack://application:,,,/BatchStudio;component/Assets/deepmath.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DEEPMATH" FontWeight="Bold" FontSize="17" />
                            <TextBlock Text="INTELLIGENT ACCOUNTING SYSTEM" FontSize="8.5" Opacity="0.6" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Entities}" SelectedItem="{Binding ActiveEntity}" DisplayMemberPath="Name" />
                    <Button Command="{Binding ShowSetupCommand}" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Entity.Add}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="11" Margin="4,8,0,0" />
                <!-- Auto Save Files: the upload to Google Drive, followed while working -->
                <StackPanel DockPanel.Dock="Bottom" Margin="4,8,8,0" DataContext="{x:Static svc:DriveSync.Instance}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Footer}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Value="{Binding FooterProgress}" Maximum="100" Height="3" Margin="0,4,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,8,16,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FlowDirection="LeftToRight" />
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28,22,28,20" Focusable="False"
                        IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}" />

        <!-- supplier / client details opened from History, Dashboard, Reports (same form as Mass Invoice); Esc / Cancel closes -->
        <Border Grid.Column="1" Panel.ZIndex="30" Background="#99000000"
                Visibility="{Binding IsPartyDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="16,12" Width="580" Margin="0,24" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <views:PartyFormView DataContext="{Binding PartyDetails}" />
            </Border>
        </Border>

        <!-- ================= Secure mode: lock screen over the whole program ================= -->
        <Grid x:Name="LockScreen" Grid.ColumnSpan="2" Panel.ZIndex="100" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              IsVisibleChanged="OnLockVisibleChanged" FlowDirection="LeftToRight"
              PreviewMouseMove="OnLockMouseMove" MouseLeave="OnLockMouseLeave">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#111A2E" Offset="0" />
                    <GradientStop Color="#070B14" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <ctl:ParticleNetwork x:Name="LockParticles" Tint="White" Opacity="0.9" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- clock -->
                <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ClockText" Text="00:00" FontSize="124" FontWeight="Light" Foreground="White"
                                   FontFamily="Segoe UI Variable Display Light, Segoe UI Light, Segoe UI">
                            <TextBlock.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.45" Color="Black" /></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="SecondsText" Text="00" FontSize="30" FontWeight="Light" Foreground="#99FFFFFF" VerticalAlignment="Bottom" Margin="10,0,0,26"
                                   FontFamily="Segoe UI Variable Display Light, Segoe UI Light, Segoe UI" />
                    </StackPanel>
                    <TextBlock x:Name="DateText" FontSize="21" Foreground="#E6FFFFFF" HorizontalAlignment="Center" Margin="0,-6,0,0"
                               FontFamily="Segoe UI Variable Display, Segoe UI" />
                </StackPanel>

                <!-- the glass card: logo, entity, password -->
                <Border Grid.Row="1" Width="380" HorizontalAlignment="Center" Margin="0,34,0,0" CornerRadius="22" Padding="28,24"
                        Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="Black" /></Border.Effect>
                    <StackPanel>
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse Fill="#26FFFFFF" />
                            <Image Source="pack://application:,,,/BatchStudio;component/Assets/deepmath.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BrandBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{DynamicResource Secure.Locked}" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding ActiveEntity.Name}" Foreground="#B3FFFFFF" FontSize="12.5" HorizontalAlignment="Center" />
                        <Grid Margin="0,20,0,0">
                            <Border CornerRadius="12" Background="#26000000" BorderBrush="#40FFFFFF" BorderThickness="1" />
                            <DockPanel Margin="4">
                                <Button DockPanel.Dock="Right" Width="38" Height="34" Click="OnLockUnlock" Cursor="Hand" ToolTip="{DynamicResource Pwd.Unlock}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="9" Background="{DynamicResource BrandBrush}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Grid>
                                    <PasswordBox x:Name="LockPassword" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                                 FontSize="15" Padding="10,6" VerticalContentAlignment="Center" KeyDown="OnLockKeyDown" PasswordChanged="OnLockPasswordChanged">
                                        <PasswordBox.Template>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </PasswordBox.Template>
                                    </PasswordBox>
                                    <TextBlock x:Name="LockHint" Text="{DynamicResource Pwd.Password}" Foreground="#80FFFFFF" FontSize="14" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </DockPanel>
                        </Grid>
                        <TextBlock Text="{Binding LockError}" Foreground="#FF8A80" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding LockError, Converter={StaticResource NonEmptyToVis}}" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand" Foreground="#CCFFFFFF" FontSize="12" MouseLeftButtonUp="OnLockForgot">
                            <Underline><Run Text="{DynamicResource Pwd.Forgot}" /></Underline>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" Text="DEEPMATH · Secure mode" Foreground="#66FFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,18" />
            </Grid>
        </Grid>
    </Grid>
</Window>
