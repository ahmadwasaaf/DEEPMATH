<UserControl x:Class="BatchStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BatchStudio.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- colour square: a check mark and a ring when it is the current accent -->
        <ControlTemplate x:Key="SwatchButton" TargetType="Button">
            <Grid Width="40" Height="40" Margin="0,0,4,4" Cursor="Hand" Background="Transparent">
                <Border x:Name="Sq" Background="{Binding Brush}" CornerRadius="4" />
                <Border x:Name="Ring" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="White"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,5,0" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Sq" Property="Opacity" Value="0.85" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="22" Margin="0,0,12,0" />
                <TextBlock Text="{DynamicResource Nav.Settings}" Style="{StaticResource PageTitle}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Appearance}" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Language}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="English" IsChecked="{Binding IsArabic, Converter={StaticResource InverseBool}}" GroupName="lang" Margin="0,0,20,0" />
                            <RadioButton Content="العربية" IsChecked="{Binding IsArabic}" GroupName="lang" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Theme}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Set.Dark}" IsChecked="{Binding IsLight, Converter={StaticResource InverseBool}}" GroupName="theme" Margin="0,0,20,0" />
                            <RadioButton Content="{DynamicResource Set.Light}" IsChecked="{Binding IsLight}" GroupName="theme" />
                        </StackPanel>
                    </Grid>
                    <!-- accent colour (like Windows "Choose your accent color") -->
                    <Grid Margin="0,14,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Accent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1">
                            <CheckBox Content="{DynamicResource Set.AccentAuto}" IsChecked="{Binding UseWindowsAccent}" Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource Set.AccentRecent}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"
                                       Visibility="{Binding HasRecentAccents, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding RecentAccents}" Margin="0,0,0,12" Visibility="{Binding HasRecentAccents, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Template="{StaticResource SwatchButton}" ToolTip="{Binding Hex}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Set.AccentColors}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding AccentPalette}" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Template="{StaticResource SwatchButton}" ToolTip="{Binding Hex}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding CustomAccentCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Set.AccentCustom}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== Home background (particle animation) ========== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ResetBackgroundCommand}" Content="{DynamicResource Bg.Reset}" />
                        <TextBlock Text="{DynamicResource Bg.Title}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource Bg.Show}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding BgEnabled}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Bg.Style}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BgStyles}" SelectedIndex="{Binding BgStyleIndex}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource Bg.Speed}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="3" Value="{Binding BgSpeed}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="{DynamicResource Bg.Opacity}" VerticalAlignment="Center" />
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.05" Maximum="1" Value="{Binding BgOpacity}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Text="{DynamicResource Bg.Density}" VerticalAlignment="Center" />
                            <Slider Grid.Row="4" Grid.Column="1" Minimum="0.4" Maximum="2" Value="{Binding BgDensity}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Text="{DynamicResource Bg.Color}" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Command="{Binding PickBgColorCommand}" Margin="8,0,0,0" Padding="4" ToolTip="{DynamicResource Bg.Color.Custom}">
                                    <Border Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{Binding BgCustomHex}" />
                                </Button>
                                <ComboBox ItemsSource="{Binding BgColors}" SelectedIndex="{Binding BgColorIndex}" HorizontalAlignment="Stretch" />
                            </DockPanel>
                            <TextBlock Grid.Row="6" Text="{DynamicResource Bg.Mouse}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding BgMouse}" VerticalAlignment="Center" />
                        </Grid>
                        <!-- live preview -->
                        <Border Grid.Column="2" CornerRadius="10" Background="#181A1F" ClipToBounds="True" Height="250" VerticalAlignment="Top"
                                MouseMove="OnPreviewMouseMove" MouseLeave="OnPreviewMouseLeave">
                            <Grid>
                                <ctl:ParticleNetwork x:Name="Preview" Tint="White" />
                                <TextBlock Text="{DynamicResource Bg.Preview}" Foreground="White" Opacity="0.55" FontSize="11" Margin="10,8" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Sync}" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="{DynamicResource Set.AutoSave}" IsChecked="{Binding AutoSave}" Margin="0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Set.Backups}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Text="{Binding KeepBackups, UpdateSourceTrigger=LostFocus}" Width="80" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding AddEntityCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Entity.Add}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{DynamicResource Set.Entities}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.RemoveEntity}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveEntityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.Rename}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ChangePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Set.ChangeFolder}" />
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenEntityWorkbookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Home.OpenWorkbook}" />
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenEntityFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Common.OpenFolder}" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource BadBrush}"
                                                       ToolTip="{DynamicResource Set.FolderNotFound}">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Exists" Converter="{StaticResource InverseBoolToVis}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Set.RemoveNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Set.About}" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
