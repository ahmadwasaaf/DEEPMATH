<UserControl x:Class="BatchStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BatchStudio.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- colour square: a check mark and a ring when it is the current accent -->
        <ControlTemplate x:Key="SwatchButton" TargetType="Button">
            <Grid Width="40" Height="40" Margin="0,0,4,4" Cursor="Hand" Background="Transparent">
                <Border x:Name="Sq" Background="{Binding Brush}" CornerRadius="4" />
                <Border x:Name="Ring" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="White"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,5,0" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Sq" Property="Opacity" Value="0.85" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="22" Margin="0,0,12,0" />
                <TextBlock Text="{DynamicResource Nav.Settings}" Style="{StaticResource PageTitle}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <!-- the arrow opens / closes the accent colours; Language and Theme stay visible -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ToggleAppearanceCommand}" Padding="8,5" VerticalAlignment="Top"
                                ToolTip="{DynamicResource Set.Accent}">
                            <TextBlock FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE70D;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppearanceOpen}" Value="True">
                                                <Setter Property="Text" Value="&#xE70E;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <TextBlock Text="{DynamicResource Set.Appearance}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Language}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="English" IsChecked="{Binding IsArabic, Converter={StaticResource InverseBool}}" GroupName="lang" Margin="0,0,20,0" />
                            <RadioButton Content="العربية" IsChecked="{Binding IsArabic}" GroupName="lang" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Theme}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Set.Dark}" IsChecked="{Binding IsLight, Converter={StaticResource InverseBool}}" GroupName="theme" Margin="0,0,20,0" />
                            <RadioButton Content="{DynamicResource Set.Light}" IsChecked="{Binding IsLight}" GroupName="theme" />
                        </StackPanel>
                    </Grid>
                    <!-- accent colour (like Windows "Choose your accent color") -->
                    <Grid Margin="0,14,0,4" Visibility="{Binding AppearanceOpen, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Accent}" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1">
                            <CheckBox Content="{DynamicResource Set.AccentAuto}" IsChecked="{Binding UseWindowsAccent}" Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource Set.AccentRecent}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"
                                       Visibility="{Binding HasRecentAccents, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding RecentAccents}" Margin="0,0,0,12" Visibility="{Binding HasRecentAccents, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Template="{StaticResource SwatchButton}" ToolTip="{Binding Hex}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Set.AccentColors}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding AccentPalette}" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Template="{StaticResource SwatchButton}" ToolTip="{Binding Hex}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding CustomAccentCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Set.AccentCustom}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== Home background (particle animation) ========== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ResetBackgroundCommand}" Content="{DynamicResource Bg.Reset}" />
                        <TextBlock Text="{DynamicResource Bg.Title}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource Bg.Show}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding BgEnabled}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Bg.Style}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BgStyles}" SelectedIndex="{Binding BgStyleIndex}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource Bg.Speed}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="3" Value="{Binding BgSpeed}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="{DynamicResource Bg.Opacity}" VerticalAlignment="Center" />
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.05" Maximum="1" Value="{Binding BgOpacity}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Text="{DynamicResource Bg.Density}" VerticalAlignment="Center" />
                            <Slider Grid.Row="4" Grid.Column="1" Minimum="0.4" Maximum="2" Value="{Binding BgDensity}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Text="{DynamicResource Bg.Color}" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Command="{Binding PickBgColorCommand}" Margin="8,0,0,0" Padding="4" ToolTip="{DynamicResource Bg.Color.Custom}">
                                    <Border Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{Binding BgCustomHex}" />
                                </Button>
                                <ComboBox ItemsSource="{Binding BgColors}" SelectedIndex="{Binding BgColorIndex}" HorizontalAlignment="Stretch" />
                            </DockPanel>
                            <TextBlock Grid.Row="6" Text="{DynamicResource Bg.Mouse}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding BgMouse}" VerticalAlignment="Center" />
                        </Grid>
                        <!-- live preview -->
                        <Border Grid.Column="2" CornerRadius="10" Background="#181A1F" ClipToBounds="True" Height="250" VerticalAlignment="Top"
                                MouseMove="OnPreviewMouseMove" MouseLeave="OnPreviewMouseLeave">
                            <Grid>
                                <ctl:ParticleNetwork x:Name="Preview" Tint="White" />
                                <TextBlock Text="{DynamicResource Bg.Preview}" Foreground="White" Opacity="0.55" FontSize="11" Margin="10,8" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== Google account: new emails on Home + Windows notifications ========== -->
            <Border x:Name="GoogleCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="26" Height="26" CornerRadius="13" Background="White" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="G" FontWeight="Bold" FontSize="16" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock Text="{DynamicResource Google.Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- the accounts added (like Google's account list): the one in use, switch, sign in again, remove -->
                    <StackPanel Visibility="{Binding Account.HasAccounts, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Account.Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- signed in, not in use: switch -->
                                                <Button Margin="8,0,0,0" Command="{Binding DataContext.Account.SwitchToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                                            <Binding Path="IsSignedIn" />
                                                            <Binding Path="IsActive" Converter="{StaticResource InverseBool}" />
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="12" Margin="0,0,8,0" />
                                                        <TextBlock Text="{DynamicResource Google.Switch}" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- signed out: sign in again -->
                                                <Button Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Content="{DynamicResource Google.SignInShort}"
                                                        Command="{Binding DataContext.Account.SignInAgainCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVis}}" />
                                                <!-- in use: sign out (it stays in the list) -->
                                                <Button Margin="8,0,0,0" Command="{Binding DataContext.Account.SignOutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xF3B1;" FontSize="12" Margin="0,0,8,0" />
                                                        <TextBlock Text="{DynamicResource Google.SignOut}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="8,0,0,0" ToolTip="{DynamicResource Google.Remove}" Padding="10,7"
                                                        Command="{Binding DataContext.Account.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                            <Grid Width="46" Height="46" Margin="0,0,14,0">
                                                <Ellipse Fill="{DynamicResource BrandBrush}" />
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="19" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                                    <!-- in use / signed out -->
                                                    <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" BorderThickness="1" BorderBrush="{StaticResource GoodBrush}"
                                                            VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="#2EA043" Opacity="0.14" />
                                                        </Border.Background>
                                                        <TextBlock Text="{DynamicResource Google.InUse}" Foreground="{StaticResource GoodBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                            Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="{DynamicResource Google.SignedOut}" Style="{StaticResource Muted}" FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Email}" Style="{StaticResource Muted}" FontSize="12" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding Account.AddAccountCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                IsEnabled="{Binding Account.IsBusy, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Google.AddAccount}" />
                            </StackPanel>
                        </Button>
                        <CheckBox Content="{DynamicResource Google.Toasts}" IsChecked="{Binding MailToasts}" Margin="0,14,0,0" />
                    </StackPanel>

                    <!-- no account yet: what it does, then Sign in -->
                    <StackPanel Visibility="{Binding Account.HasAccounts, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{DynamicResource Google.Intro}" TextWrapping="Wrap" Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Command="{Binding GoogleSignInCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,7"
                                    IsEnabled="{Binding Account.IsBusy, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="White" Margin="0,0,10,0">
                                        <TextBlock Text="G" FontWeight="Bold" FontSize="13" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource Google.SignIn}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Account.Status}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="Account.Status" Converter="{StaticResource NonEmptyToVis}" />
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- OAuth client: built into the program; shown and changeable here (closed by default) -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <DockPanel Background="Transparent" Cursor="Hand">
                                <DockPanel.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleClientCommand}" />
                                </DockPanel.InputBindings>
                                <Button DockPanel.Dock="Right" Command="{Binding ToggleClientCommand}" Padding="8,5">
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE70D;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClientOpen}" Value="True">
                                                        <Setter Property="Text" Value="&#xE70E;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Google.Client}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ClientKind}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Visibility="{Binding ClientOpen, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Google.ClientHelp}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource Google.ClientId}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Google.ClientSecret}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GoogleClientSecret, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                             FontFamily="Consolas" Margin="0,8,0,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{Binding SaveClientCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="90">
                                        <TextBlock Text="{DynamicResource Common.Save}" />
                                    </Button>
                                    <Button Command="{Binding LoadGoogleClientCommand}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Google.LoadFile}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ResetClientCommand}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Google.ClientUseBuiltIn}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding ClientNote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding ClientNote, Converter={StaticResource NonEmptyToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Sync}" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="{DynamicResource Set.AutoSave}" IsChecked="{Binding AutoSave}" Margin="0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Set.Backups}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Text="{Binding KeepBackups, UpdateSourceTrigger=LostFocus}" Width="80" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding AddEntityCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Entity.Add}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{DynamicResource Set.Entities}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.RemoveEntity}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveEntityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.Rename}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ChangePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Set.ChangeFolder}" />
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenEntityWorkbookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Home.OpenWorkbook}" />
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenEntityFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Common.OpenFolder}" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource BadBrush}"
                                                       ToolTip="{DynamicResource Set.FolderNotFound}">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Exists" Converter="{StaticResource InverseBoolToVis}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Set.RemoveNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Set.About}" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
