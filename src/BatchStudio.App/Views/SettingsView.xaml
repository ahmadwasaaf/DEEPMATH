<UserControl x:Class="BatchStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="22" Margin="0,0,12,0" />
                <TextBlock Text="{DynamicResource Nav.Settings}" Style="{StaticResource PageTitle}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Appearance}" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Language}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="English" IsChecked="{Binding IsArabic, Converter={StaticResource InverseBool}}" GroupName="lang" Margin="0,0,20,0" />
                            <RadioButton Content="العربية" IsChecked="{Binding IsArabic}" GroupName="lang" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Set.Theme}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Set.Dark}" IsChecked="{Binding IsLight, Converter={StaticResource InverseBool}}" GroupName="theme" Margin="0,0,20,0" />
                            <RadioButton Content="{DynamicResource Set.Light}" IsChecked="{Binding IsLight}" GroupName="theme" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Sync}" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="{DynamicResource Set.AutoSave}" IsChecked="{Binding AutoSave}" Margin="0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Set.Backups}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Text="{Binding KeepBackups, UpdateSourceTrigger=LostFocus}" Width="80" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding AddEntityCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Entity.Add}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{DynamicResource Set.Entities}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.RemoveEntity}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveEntityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Set.Rename}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ChangePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Set.ChangeFolder}" />
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenEntityWorkbookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Home.OpenWorkbook}" />
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenEntityFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Common.OpenFolder}" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource BadBrush}"
                                                       ToolTip="{DynamicResource Set.FolderNotFound}">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Exists" Converter="{StaticResource InverseBoolToVis}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Set.RemoveNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Set.About}" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
