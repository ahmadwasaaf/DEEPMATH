<UserControl x:Class="BatchStudio.App.Views.DataSetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:BatchStudio.App.Services"
             xmlns:vm="clr-namespace:BatchStudio.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- suppliers list: the name with the number of bank accounts on its right -->
        <DataTemplate x:Key="NameWithBadge">
            <DockPanel Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border DockPanel.Dock="Right">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BankBadgeBorder}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Badge}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsCategories, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="ToolTip" Value="{DynamicResource Cat.BadgeTip}" />
                                </DataTrigger>
                                <!-- on the selected (blue) row: a light badge -->
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter Property="Background" Value="#40FFFFFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="Badge" FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource BankBadge}">
                                <Binding />
                                <Binding Path="DataContext.BadgeVersion" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding c1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="22" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="10,2" Margin="12,4,0,0" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="{Binding RowCount, Mode=OneWay, StringFormat=N0}" />
                        <Run Text="{DynamicResource Common.Rows}" />
                    </TextBlock>
                </Border>
                <!-- suppliers: every bank account of every supplier as PDFs, in one Desktop folder -->
                <Button Command="{Binding ExportAllBanksCommand}" Padding="8,4" MinWidth="0" Margin="10,4,0,0" VerticalAlignment="Center"
                        ToolTip="{DynamicResource BankPdf.AllTip}"
                        Visibility="{Binding IsSuppliersSheet, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ExportAllText}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Visibility="{Binding IsExportingAll, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="170" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{Binding AddRowCommand}" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Common.Add}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteRowCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Common.Delete}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Common.Save}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ReloadCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Common.Reload}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                </Button>
                <Button Command="{Binding OpenInExcelCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Common.OpenInExcel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Common.OpenFolder}"
                        Visibility="{Binding IsPartySheet, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" />
                </Button>
                <!-- Suppliers / Clients: the full check of the list in place of Open folder -->
                <Button Command="{Binding HealthCheckCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Health.Tip}"
                        Visibility="{Binding IsPartySheet, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="14" />
                </Button>
                <StackPanel Orientation="Horizontal" Visibility="{Binding CompactGrid, Converter={StaticResource BoolToVis}}">
                    <Border Width="1" Margin="4,6,12,6" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Button Command="{Binding ViewReportCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Act.ViewReportShort}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportReportCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Act.ExportReportShort}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <Border x:Name="SearchHost" Grid.Column="1" Margin="8,0,0,0">
            <Grid x:Name="SearchBox" HorizontalAlignment="Right" Width="300">
                <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="30,6,8,6" VerticalContentAlignment="Center" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left" Opacity="0.7" />
                <TextBlock Text="{DynamicResource Common.Search}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            </Border>
        </Grid>

        <!-- grid + details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition x:Name="DetailsColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <!-- drag the list's right edge to widen it (long names); double-click resets -->
            <GridSplitter x:Name="ListSplitter" Grid.Column="1" Style="{StaticResource ListSplitter}" ToolTip="{DynamicResource Common.DragWidth}" />

            <DataGrid x:Name="Grid" Grid.Column="0" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="True" AutoGeneratingColumn="OnAutoGeneratingColumn"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" RowHeight="34" />

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                <!-- ================= Categories: the selected category and its items ================= -->
                <DockPanel Visibility="{Binding IsCategories, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrandSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="15" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                <Run Text="{Binding CategoryItemCount, Mode=OneWay, StringFormat=N0}" /><Run Text=" " /><Run Text="{DynamicResource Cat.ItemsWord}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <!-- the category's own fields (ID, name, status), side by side -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Fields}" Margin="0,0,0,6" AlternationCount="3"
                                  Visibility="{Binding ShowUncategorized, Converter={StaticResource InverseBoolToVis}}">
                        <!-- ID narrow, the name wide, the status narrow -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type vm:FieldEditViewModel}">
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Padding="9,6" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                    <ComboBox ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=Explicit}" svc:ComboSearch.IsEnabled="True" HorizontalAlignment="Stretch"
                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                    <!-- items toolbar: search (all items) and + Item -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding AddItemCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Cat.AddItem}" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <TextBox x:Name="ItemSearchBox" Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="30,6,8,6" VerticalContentAlignment="Center" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Opacity="0.6" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock Text="{DynamicResource Cat.SearchItems}" Opacity="0.5" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ItemSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <!-- Uncategorized: items with no category (or one that no longer exists) -->
                    <Button DockPanel.Dock="Bottom" Command="{Binding ShowUncategorizedItemsCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UncategorizedCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock>
                            <Run Text="{DynamicResource Cat.Uncategorized}" /><Run Text=" · " /><Run Text="{Binding UncategorizedCount, Mode=OneWay, StringFormat=N0}" />
                        </TextBlock>
                    </Button>
                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding CategoryItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                              EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseRightButtonDown="OnItemRightDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Cat.DeleteItem}" Click="OnDeleteItem">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Cat.Code}" Binding="{Binding c0}" IsReadOnly="True" Width="Auto" MinWidth="70"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="6,0" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Cat.ItemName}" Binding="{Binding c1, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="6,0" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource Cat.Price}" Binding="{Binding c2, UpdateSourceTrigger=LostFocus}" Width="80"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="6,0" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Cat.Category}" Width="90" SortMemberPath="c3">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding c3}" VerticalAlignment="Center" Margin="6,0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.CategoryChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding c3, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Cat.Status}" Binding="{Binding c4, UpdateSourceTrigger=LostFocus}" Width="75"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="6,0" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Visibility="{Binding IsCategories, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Common.Details}" Style="{StaticResource SectionTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type vm:FieldEditViewModel}">
                                    <StackPanel Margin="0,0,6,12">
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" Padding="11,9,11,9" VerticalContentAlignment="Top"
                                                 AcceptsReturn="{Binding IsLong}" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                        <ComboBox ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=Explicit}" svc:ComboSearch.IsEnabled="True" HorizontalAlignment="Stretch" MinHeight="38" VerticalContentAlignment="Center"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeFieldViewModel}">
                                    <StackPanel Margin="0,0,6,12">
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4">
                                            <Run Text="{Binding Caption, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Note, Mode=OneWay}" />
                                        </TextBlock>
                                        <DockPanel IsEnabled="{Binding Supported}">
                                            <Button DockPanel.Dock="Right" Command="{Binding PickCommand}" Margin="8,0,0,0" Padding="0" Width="64" MinHeight="38"
                                                    ToolTip="{DynamicResource Theme.Pick}">
                                                <Grid Width="60" Height="26">
                                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding Swatch}" />
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasColor, Converter={StaticResource InverseBoolToVis}}" />
                                                </Grid>
                                            </Button>
                                            <Grid>
                                                <TextBox x:Name="ThemeHex" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="11,0,11,0" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="14"
                                                         VerticalContentAlignment="Center" LostFocus="OnThemeLostFocus" KeyDown="OnThemeKeyDown" />
                                                <TextBlock Text="Not Assigned Yet" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5" FlowDirection="LeftToRight">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=ThemeHex}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock FontSize="13" Margin="0,0,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                        <Setter Property="Text" Value="&#xE73E;" />
                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Text" Value="&#xE895;" />
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWaitingForExcel}" Value="True">
                                <Setter Property="Text" Value="&#xE7BA;" />
                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- the same name saved twice: merge the newer record into the older one -->
            <Button DockPanel.Dock="Right" Command="{Binding MergeDuplicatesCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,4" Margin="10,0,0,0"
                    Visibility="{Binding HasMergeOffer, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA3C;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding MergeOffer}" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <!-- full check of the list: each finding with the records concerned (click one to open it) -->
        <Border Grid.RowSpan="4" Panel.ZIndex="20" Background="#99000000" CornerRadius="8"
                Visibility="{Binding IsHealthOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="40,24" MaxWidth="900"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseHealthCommand}" Padding="6,3" MinWidth="0" Background="Transparent" BorderThickness="0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13" />
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="17" Margin="0,0,10,0" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Health.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding HealthSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HealthItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,10,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource WarnBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severe}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BadBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                                <ItemsControl ItemsSource="{Binding Links}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding Open}" Margin="0,2,8,2" Padding="8,3" ToolTip="{DynamicResource Health.Open}">
                                                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                                    <TextBlock Text="{Binding ShortId}" Foreground="{DynamicResource BrandBrush}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding Name}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseHealthCommand}" Padding="14,6" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Health.Close}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding HealthCheckCommand}" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Health.Again}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
