<UserControl x:Class="BatchStudio.App.Views.EntitySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Setup.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Setup.Intro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Setup.Workbook}" Style="{StaticResource SectionTitle}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding WorkbookPath, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Setup.Name}" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                    <TextBox Text="{Binding EntityName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap">
                        <Run Text="{DynamicResource Setup.ArchiveAt}" />
                        <Run Text="{Binding ArchivePath, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Text="{DynamicResource Setup.WorkbookHint}" />
                    <Button Content="{DynamicResource Setup.Link}" Command="{Binding LinkCommand}" Margin="0,16,0,0"
                            HorizontalAlignment="Left" Padding="22,7" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Button Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Left"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
