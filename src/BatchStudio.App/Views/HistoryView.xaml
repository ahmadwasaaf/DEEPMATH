<UserControl x:Class="BatchStudio.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== header band (like the V28 sheet) ========== -->
        <Border Grid.Row="0" CornerRadius="8" Padding="20,14" Margin="0,0,0,12" Background="#1F2D46">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Command="{Binding ExportReportCommand}" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Hist.Report}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CheckFilesCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Hist.Check}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="13" />
                    </Button>
                    <Button Command="{Binding OpenSheetCommand}" ToolTip="{DynamicResource Hist.Sheet}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Hist.Title}" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding CountText}" Foreground="White" FontSize="22" Margin="0,0,24,4" VerticalAlignment="Center" />
                        <RadioButton GroupName="tab" Foreground="White" Margin="0,0,16,0" VerticalAlignment="Center"
                                     Content="{DynamicResource Hist.All}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=ALL}" />
                        <RadioButton GroupName="tab" Foreground="White" Margin="0,0,16,0" VerticalAlignment="Center"
                                     Content="{DynamicResource Hist.Suppliers}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=SUPPLIERS}" />
                        <RadioButton GroupName="tab" Foreground="White" VerticalAlignment="Center"
                                     Content="{DynamicResource Hist.Clients}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=CLIENTS}" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== filters ========== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{DynamicResource Hist.Total}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                </StackPanel>
                <WrapPanel>
                    <Grid Width="320" Margin="0,0,14,6">
                        <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" VerticalContentAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left" Opacity="0.7" />
                        <TextBlock Text="{DynamicResource Hist.Search}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                        <TextBlock Text="{DynamicResource Hist.Period}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="150" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                        <TextBlock Text="{DynamicResource Hist.WeekStarts}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{Binding WeekDays}" SelectedItem="{Binding WeekStart}" Width="130" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Hist.From}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                        <DatePicker SelectedDate="{Binding From}" Width="140" Margin="0,0,12,0" />
                        <TextBlock Text="{DynamicResource Hist.To}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                        <DatePicker SelectedDate="{Binding To}" Width="140" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ========== records ========== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeight="38" EnableRowVirtualization="True"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Resources>
                    <Style x:Key="Mid" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="6,0" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.No}" Binding="{Binding No}" Width="Auto" MinWidth="64" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Name}" Binding="{Binding Name}" Width="*" MinWidth="150" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="Auto" MinWidth="100" SortMemberPath="Amount" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Date}" Binding="{Binding DateText}" Width="Auto" MinWidth="90" SortMemberPath="SortDate" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.InvoiceNo}" Binding="{Binding InvoiceNo}" Width="Auto" MinWidth="100" />
                    <DataGridTemplateColumn Header="{StaticResource Col.Status}" Width="Auto" MinWidth="110" SortMemberPath="FileExists">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileExists}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{StaticResource Col.Actions}" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0" VerticalAlignment="Center">
                                    <ComboBox x:Name="Act" SelectionChanged="OnActionChosen" HorizontalAlignment="Stretch" MinHeight="28" Padding="10,3">
                                        <ComboBoxItem Tag="open" Content="{DynamicResource Act.Open}" />
                                        <ComboBoxItem Tag="remove" Content="{DynamicResource Act.Remove}" />
                                        <ComboBoxItem Tag="pdf" Content="{DynamicResource Act.Pdf}" />
                                        <ComboBoxItem Tag="report" Content="{DynamicResource Act.ViewReport}" />
                                        <ComboBoxItem Tag="exportreport" Content="{DynamicResource Act.ExportReport}" />
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource Col.Actions}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,30,0" Opacity="0.75">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Act}" Value="-1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ========== actions on the selected invoice ========== -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsEnabled="{Binding HasSelection}">
                <Button Command="{Binding OpenInvoiceCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Hist.Open}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportInvoicePdfCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Hist.Pdf}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CompanyReportCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Rep.Full}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowInFolderCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Hist.Folder}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" />
                </Button>
                <Button Command="{Binding RelinkCommand}" Margin="0,0,8,0" Visibility="{Binding SelectedMissing, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Hist.Relink}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RemoveCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource BadBrush}" />
                        <TextBlock Text="{DynamicResource Hist.Remove}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="120" Height="3" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
