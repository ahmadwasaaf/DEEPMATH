<Window x:Class="BatchStudio.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI">
    <Border Margin="16" CornerRadius="14" Padding="24,20" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" /></Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource BrandSoftBrush}" Margin="0,0,12,0">
                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="18" Foreground="{DynamicResource BrandBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
            </StackPanel>
            <TextBlock x:Name="SubText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" FontSize="12.5" />

            <TextBlock x:Name="FirstLabel" Text="{DynamicResource Pwd.Password}" FontSize="11" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4" />
            <PasswordBox x:Name="First" Padding="8,6" KeyDown="OnKeyDown" PasswordChanged="OnTyped" />
            <StackPanel x:Name="ConfirmPanel" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource Pwd.Confirm}" FontSize="11" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4" />
                <PasswordBox x:Name="Second" Padding="8,6" KeyDown="OnKeyDown" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#E5534B" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

            <DockPanel Margin="0,18,0,0">
                <TextBlock x:Name="ForgotLink" DockPanel.Dock="Left" VerticalAlignment="Center" Cursor="Hand" FontSize="12"
                           Foreground="{DynamicResource BrandBrush}" MouseLeftButtonUp="OnForgot">
                    <Underline><Run Text="{DynamicResource Pwd.Forgot}" /></Underline>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="{DynamicResource Common.Cancel}" Padding="16,7" Margin="0,0,8,0" Click="OnCancel" />
                    <Button x:Name="OkBtn" Style="{DynamicResource AccentButtonStyle}" Padding="18,7" Click="OnOk">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="OkGlyph" Style="{StaticResource Icon}" Text="&#xE785;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock x:Name="OkText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
