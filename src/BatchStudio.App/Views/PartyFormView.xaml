<UserControl x:Class="BatchStudio.App.Views.PartyFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:BatchStudio.App.Services"
             xmlns:vm="clr-namespace:BatchStudio.App.ViewModels">
    <!-- new supplier / client: the sheet's columns, bank accounts, theme (New Invoice "+" and Mass Invoice "+") -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="ThemeFieldTemplate">
                                    <StackPanel Margin="0,0,6,12">
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4">
                                            <Run Text="{Binding Caption, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Note, Mode=OneWay}" />
                                        </TextBlock>
                                        <DockPanel IsEnabled="{Binding Supported}">
                                            <Button DockPanel.Dock="Right" Command="{Binding PickCommand}" Margin="8,0,0,0" Padding="0" Width="64" MinHeight="38"
                                                    ToolTip="{DynamicResource Theme.Pick}">
                                                <Grid Width="60" Height="26">
                                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding Swatch}" />
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasColor, Converter={StaticResource InverseBoolToVis}}" />
                                                </Grid>
                                            </Button>
                                            <Grid>
                                                <TextBox x:Name="ThemeHex" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="11,0,11,0" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="14"
                                                         VerticalContentAlignment="Center" LostFocus="OnThemeLostFocus" KeyDown="OnThemeKeyDown" />
                                                <TextBlock Text="Not Assigned Yet" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5" FlowDirection="LeftToRight">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=ThemeHex}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
        <DataTemplate x:Key="PartyFieldTemplate" DataType="{x:Type vm:NewFieldViewModel}">
            <StackPanel Margin="0,0,6,12">
                <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="11,9,11,9"
                         AcceptsReturn="{Binding IsLong}" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                <ComboBox ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=Explicit}" svc:ComboSearch.IsEnabled="True" HorizontalAlignment="Stretch" MinHeight="38" VerticalContentAlignment="Center"
                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" Padding="22,9" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource Common.Save}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Content="{DynamicResource Common.Cancel}" Padding="18,9" />
            <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" Height="3" Margin="0,6,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:NewFieldViewModel}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PartyFieldTemplate}" Focusable="False" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ThemeFieldViewModel}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ThemeFieldTemplate}" Focusable="False" />
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
