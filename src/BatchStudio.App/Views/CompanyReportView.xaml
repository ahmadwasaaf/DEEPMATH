<UserControl x:Class="BatchStudio.App.Views.CompanyReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- centred column title: the header itself is centred from code (keeps the Fluent header look) -->
        <DataTemplate x:Key="CenterHeader">
            <TextBlock Text="{Binding}" Loaded="OnCenterHeaderLoaded" />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- company + figures in one card -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" VerticalAlignment="Top" Margin="0,0,14,0" ToolTip="{DynamicResource Rep.Back}"
                        Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="13" />
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding ExportPdfCommand}" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Top" Margin="14,0,0,0"
                        Visibility="{Binding ShowPdf, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Rep.Pdf}" />
                    </StackPanel>
                </Button>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Rep.Title}" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NativeName}" FontSize="13" Opacity="0.85" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Category}" />
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Rep.Total}" Style="{StaticResource Muted}" FontSize="11" />
                            <TextBlock Text="{Binding TotalText}" FontSize="22" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            <TextBlock Margin="0,2,0,8">
                                <Run Text="{Binding InvoicesText}" /><Run Text="   " /><Run Text="{Binding BanksText}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Dash.Period}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="140" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                <DatePicker SelectedDate="{Binding From}" Width="125" Margin="0,0,6,0" />
                                <DatePicker SelectedDate="{Binding To}" Width="125" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- activities (fold with the arrow) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Command="{Binding SaveDescriptionCommand}"
                            Visibility="{Binding DescriptionDirty, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Rep.SaveDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleActivitiesCommand}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="2,4" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Rep.Activities}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE70E;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActivitiesExpanded}" Value="False">
                                                <Setter Property="Text" Value="&#xE70D;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Padding="12,10,12,10" Margin="0,6,0,0"
                         MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Visibility="{Binding ActivitiesExpanded, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>

        <!-- invoices -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <!-- the invoices, then their total right under the Amount column (the list and the total scroll together) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel>
            <DataGrid x:Name="InvoiceGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" SelectionMode="Single"
                      VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnGridWheel" PreviewMouseRightButtonDown="OnRowRightClick">
                <!-- right-click on a row: the same choices as its Actions list -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Tag="open" Header="{DynamicResource Act.Open}" Click="OnMenuAction" />
                        <MenuItem Tag="pdf" Header="{DynamicResource Act.Pdf}" Click="OnMenuAction" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Resources>
                        <Style x:Key="Mid" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.No}" Binding="{Binding No}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="*" MinWidth="120" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Date}" Binding="{Binding DateText}" Width="Auto" MinWidth="100" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.InvoiceNo}" Binding="{Binding InvoiceNo}" Width="Auto" MinWidth="120" />
                    <!-- the same "Actions" list as Invoice History / Dashboard -->
                    <DataGridTemplateColumn Header="{StaticResource Col.Actions}" HeaderTemplate="{StaticResource CenterHeader}" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="160" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ComboBox x:Name="Act" SelectionChanged="OnActionChosen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="28" Padding="10,3">
                                        <ComboBoxItem Tag="open" Content="{DynamicResource Act.Open}" />
                                        <ComboBoxItem Tag="pdf" Content="{DynamicResource Act.Pdf}" />
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource Col.Actions}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,22,0" Opacity="0.75">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=Act}" Value="-1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Margin="0,14,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Columns[0].ActualWidth, ElementName=InvoiceGrid}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="{DynamicResource Rep.Total}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock FontSize="22" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                        <Run Text="{Binding TotalText, Mode=OneWay}" /><Run Text=" USD" />
                    </TextBlock>
                </StackPanel>
            </Grid>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- status line only while there is something to say: the report ends level with the list beside it -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Status}" Value="" />
                                <Condition Binding="{Binding IsBusy}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Status}" Value="{x:Null}" />
                                <Condition Binding="{Binding IsBusy}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="120" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
