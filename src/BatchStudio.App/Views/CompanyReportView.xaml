<UserControl x:Class="BatchStudio.App.Views.CompanyReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" CornerRadius="8" Padding="20,14" Margin="0,0,0,12" Background="#1F2D46">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" VerticalAlignment="Top" Margin="0,0,16,0" ToolTip="{DynamicResource Rep.Back}"
                        Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="13" />
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding ExportPdfCommand}" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Rep.Pdf}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Rep.Title}" Foreground="#B8C4D6" FontSize="12" />
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NativeName}" Foreground="#D6DEEA" FontSize="15" />
                    <TextBlock Foreground="#B8C4D6" FontSize="12" Margin="0,4,0,0">
                        <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Category}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- figures, period, activities -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" MinWidth="300">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Rep.Total}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding TotalText}" FontSize="26" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,4,0,10">
                        <Run Text="{Binding InvoicesText}" /><Run Text="   " /><Run Text="{Binding BanksText}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Dash.Period}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="150" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                        <DatePicker SelectedDate="{Binding From}" Width="130" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding To}" Width="130" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Command="{Binding SaveDescriptionCommand}" IsEnabled="{Binding DescriptionDirty}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Rep.SaveDesc}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{DynamicResource Rep.Activities}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="90" MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- invoices -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" SelectionMode="Single">
                <DataGrid.Resources>
                        <Style x:Key="Mid" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.No}" Binding="{Binding No}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="*" MinWidth="120" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Date}" Binding="{Binding DateText}" Width="Auto" MinWidth="100" />
                    <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.InvoiceNo}" Binding="{Binding InvoiceNo}" Width="Auto" MinWidth="120" />
                    <DataGridTemplateColumn Header="{StaticResource Col.Actions}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <Button Command="{Binding DataContext.OpenInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                            Padding="8,2" Margin="0,0,6,0" ToolTip="{DynamicResource Hist.Open}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" />
                                    </Button>
                                    <Button Command="{Binding DataContext.InvoicePdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                            Padding="8,2" ToolTip="{DynamicResource Rep.InvPdf}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="120" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
