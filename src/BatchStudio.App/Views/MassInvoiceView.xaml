<UserControl x:Class="BatchStudio.App.Views.MassInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:BatchStudio.App.Services"
             xmlns:local="clr-namespace:BatchStudio.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- centred column title: the header itself is centred from code (keeps the Fluent header look) -->
        <DataTemplate x:Key="CenterHeader">
            <TextBlock Text="{Binding}" Loaded="OnCenterHeaderLoaded" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== header band (like the BATCH STUDIO sheet) ========== -->
        <Border Grid.Row="0" CornerRadius="8" Padding="20,14" Margin="0,0,0,12" Background="#1F2D46">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Orientation="Horizontal">
                    <!-- Analysis: a folder of supplier documents → rows (suppliers only) -->
                    <Button Command="{Binding AnalyseCommand}" Margin="0,0,10,0" Padding="12,6" VerticalAlignment="Center"
                            ToolTip="{DynamicResource Analysis.Tip}"
                            Visibility="{Binding IsSuppliers, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Google-style paperclip (Material "attach_file") -->
                            <Viewbox Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z" /></Canvas></Viewbox>
                            <TextBlock Text="{DynamicResource Analysis.Button}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" Width="170" HorizontalContentAlignment="Center"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="18" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Mass.Title}" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Mass.Subtitle}" Foreground="#C9D4E5" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== toolbar ========== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding GenerateCommand}" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" Padding="16,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Mass.Generate}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding ClearCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Mass.Clear}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding ExportPdfCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Mass.ExportPdf}" />
                    </StackPanel>
                </Button>
                <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <TextBlock Text="{DynamicResource Mass.DefaultItems}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding DefaultCount, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalContentAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="{DynamicResource Mass.DefaultDate}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding DefaultDate}" Width="135" Margin="0,0,10,0" />
                    <Button Command="{Binding ApplyDefaultsCommand}" Margin="0,0,14,0">
                        <TextBlock Text="{DynamicResource Mass.Apply}" />
                    </Button>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ========== the 200 rows (only the visible ones are built) ========== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid SelectedIndex="{Binding SelectedRowIndex}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                      VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="2,2" VirtualizingPanel.CacheLengthUnit="Page">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="36" HeaderTemplate="{StaticResource CenterHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- the row number opens the picked supplier / client's details -->
                                <TextBlock Text="{Binding No}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6,4" Background="Transparent"
                                           ToolTip="{DynamicResource Mass.DetailsTip}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowDetailsCommand}" />
                                    </TextBlock.InputBindings>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0.7" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                                <!-- no supplier / client picked: a plain number -->
                                                <DataTrigger Binding="{Binding PartyName}" Value="">
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                                    <Setter Property="Opacity" Value="0.7" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter Property="TextDecorations" Value="{x:Null}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="3*" MinWidth="220">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{Binding DataContext.PartyHeader, RelativeSource={RelativeSource AncestorType=UserControl}}" Loaded="OnCenterHeaderLoaded" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding PartyOptions}" Text="{Binding PartyName, UpdateSourceTrigger=Explicit}" svc:ComboSearch.IsEnabled="True" FlowDirection="LeftToRight"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2,2" MaxDropDownHeight="320" Loaded="OnPartyComboLoaded"
                                          IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel HorizontalAlignment="Left">
                                                    <Border DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BankBadgeBorder}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=Badge}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="Badge" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource BankBadge}">
                                                        <Binding />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- X on the selected row: clears the whole row -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,62,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                                            <Condition Binding="{Binding HasContent}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Command="{Binding ClearRowCommand}" Padding="5,2" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                                Focusable="False" ToolTip="{DynamicResource Mass.ClearRow}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </Border>
                                    <!-- "+": a new supplier / client for this row -->
                                    <Button Command="{Binding AddPartyCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0"
                                            Padding="5,2" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" Focusable="False"
                                            ToolTip="{Binding DataContext.AddPartyTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{StaticResource Mass.Amount}" Width="130" HeaderTemplate="{StaticResource CenterHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="2,2" MinHeight="30" Padding="4,2" IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}" FlowDirection="LeftToRight" LostFocus="OnAmountLostFocus" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{StaticResource Mass.Items}" Width="80" HeaderTemplate="{StaticResource CenterHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- hover: two small arrows to add / remove one item with the mouse -->
                                <Grid x:Name="CountCell" Background="Transparent"
                                      IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}">
                                    <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="2,2" MinHeight="30" Padding="4,2,16,2" />
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CountCell}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <RepeatButton Command="{Binding CountUpCommand}" Width="16" Height="13" Padding="0" MinWidth="0" MinHeight="0" Delay="350" Interval="90"
                                                      Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand">
                                            <Path Data="M0,4 L4,0 L8,4 Z" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </RepeatButton>
                                        <RepeatButton Command="{Binding CountDownCommand}" Width="16" Height="13" Padding="0" MinWidth="0" MinHeight="0" Delay="350" Interval="90"
                                                      Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand">
                                            <Path Data="M0,0 L8,0 L4,4 Z" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </RepeatButton>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{StaticResource Mass.InvoiceNo}" Width="130" HeaderTemplate="{StaticResource CenterHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="2,2" MinHeight="30" Padding="4,2" FlowDirection="LeftToRight" LostFocus="OnInvoiceNoLostFocus"
                                         IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{StaticResource Mass.Date}" Width="140" HeaderTemplate="{StaticResource CenterHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Date}" VerticalAlignment="Center" Margin="2,2"
                                            IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{StaticResource Mass.Status}" Width="1*" MinWidth="110" HeaderTemplate="{StaticResource CenterHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="ok">
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="warn">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="fail">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="run">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ========== summary (like B60:B62) ========== -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar Height="4" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,8"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>

        <!-- new supplier / client (from a row's "+"): over the page, Esc / Cancel closes -->
        <Border Grid.RowSpan="4" Panel.ZIndex="20" Background="#99000000" CornerRadius="8"
                Visibility="{Binding IsAddingParty, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="16,12" Width="580" Margin="0,16" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <local:PartyFormView DataContext="{Binding PartyForm}" />
            </Border>
        </Border>

        <!-- Analysis running: progress over the page, Cancel stops the engine -->
        <Border Grid.RowSpan="4" Panel.ZIndex="21" Background="#99000000" CornerRadius="8"
                Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="24,20" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Viewbox Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource BrandBrush}" Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z" /></Canvas></Viewbox>
                        <TextBlock Text="{DynamicResource Analysis.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Height="6" Maximum="100" Value="{Binding AnalysisProgress}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding AnalysisText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    <TextBlock Text="{DynamicResource Analysis.Wait}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Command="{Binding CancelAnalysisCommand}" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="16,6">
                        <TextBlock Text="{DynamicResource Common.Cancel}" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- Analysis review: every document with its supplier, account and amount; Approve all puts them on the rows -->
        <Border Grid.RowSpan="4" Panel.ZIndex="22" Background="#99000000" CornerRadius="8"
                Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="24,16" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseReviewCommand}" Padding="6,3" MinWidth="0" Background="Transparent" BorderThickness="0"
                                ToolTip="{DynamicResource Common.Cancel}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13" />
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource BrandBrush}" Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z" /></Canvas></Viewbox>
                                <TextBlock Text="{DynamicResource Analysis.ReviewTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Analysis.ReviewHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReviewItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" IsReadOnly="True"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <!-- select all / none (some chosen: half state) -->
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.AllChosen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ToolTip="{DynamicResource Analysis.SelectAll}" MinWidth="0" Margin="6,0,0,0" HorizontalAlignment="Center" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsReady}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Margin="6,0,0,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{StaticResource Analysis.ColFile}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- click: opens the document -->
                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" Cursor="Hand"
                                                   Foreground="{DynamicResource BrandBrush}" ToolTip="{DynamicResource Analysis.OpenFile}" FlowDirection="LeftToRight">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenFileCommand}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{StaticResource Analysis.ColSupplier}" Width="3*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="4,4" ToolTip="{Binding Details}">
                                            <!-- a new supplier's name can be corrected before it is saved -->
                                            <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" MinHeight="28" Padding="4,2"
                                                     VerticalContentAlignment="Center" Visibility="{Binding CanEditName, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding SupplierName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                       Visibility="{Binding CanEditName, Converter={StaticResource InverseBoolToVis}}" />
                                            <TextBlock Text="{Binding AccountText}" Style="{StaticResource Muted}" FontSize="11" Margin="4,2,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                            <!-- more than one supplier fits: pick the right one -->
                                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Picked}" DisplayMemberPath="Name" Margin="0,6,0,0"
                                                      HorizontalAlignment="Stretch" FlowDirection="LeftToRight"
                                                      Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{StaticResource Analysis.ColAmount}" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 Margin="2,2" MinHeight="30" Padding="4,2" FlowDirection="LeftToRight" LostFocus="OnReviewAmountLostFocus" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{StaticResource Analysis.ColStatus}" Width="2*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="8,4">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="ok">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="acct">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="new">
                                                                <Setter Property="Foreground" Value="#8E7CFF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="test">
                                                                <Setter Property="Foreground" Value="#FF8A65" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="warn">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="block">
                                                                <Setter Property="Foreground" Value="#EF5350" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- two lines at most; a blocked document opens the full conflict below -->
                                            <TextBlock Text="{Binding ShortRemarks}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="30" TextTrimming="CharacterEllipsis" ToolTip="{Binding Remarks}"
                                                       Visibility="{Binding HasRemarks, Converter={StaticResource BoolToVis}}" />
                                            <Button Command="{Binding ToggleDetailsCommand}" Cursor="Hand" HorizontalAlignment="Left" Margin="0,3,0,0" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Focusable="False"
                                                    Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#EF5350" VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowDetails}" Value="True">
                                                                        <Setter Property="Data" Value="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Margin="4,0,0,0" FontSize="11" Foreground="#EF5350" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{DynamicResource Analysis.ViewConflict}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowDetails}" Value="True">
                                                                        <Setter Property="Text" Value="{DynamicResource Analysis.HideConflict}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <Border Margin="0,4,0,2" Padding="8,6" CornerRadius="6" Background="#22EF5350" BorderBrush="#55EF5350" BorderThickness="1"
                                                    Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ConflictDetails}" FontSize="11" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding ApproveAllCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="18,7" Margin="8,0,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Analysis.ApproveAll}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding CloseReviewCommand}" Padding="14,7"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <TextBlock Text="{DynamicResource Common.Cancel}" />
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ReviewError}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
