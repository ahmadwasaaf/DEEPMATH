<UserControl x:Class="BatchStudio.App.Views.NewInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:BatchStudio.App.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NewInvoiceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Inv.New}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="22" Margin="0,0,12,0" />
                <TextBlock Text="{DynamicResource Nav.NewInvoice}" Style="{StaticResource PageTitle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ form ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Smart Invoice Repair banner -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Background="#33F2A93B" BorderBrush="#F2A93B" BorderThickness="1"
                                Visibility="{Binding IsRepair, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding CancelRepairCommand}" Padding="8,3" VerticalAlignment="Top" ToolTip="{DynamicResource Rep.Cancel}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="SMART INVOICE REPAIR" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding RepairInfo}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Inv.Template}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" IsEnabled="{Binding IsNormal}" />
                        <TextBlock Text="{Binding TemplateInfo}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />

                        <TextBlock Text="{DynamicResource Inv.PartyType}" Style="{StaticResource FieldLabel}" />
                        <DockPanel IsEnabled="{Binding IsNormal}">
                            <Button DockPanel.Dock="Right" Command="{Binding AddPartyCommand}" Padding="9,5" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Inv.AddParty}" Style="{DynamicResource AccentButtonStyle}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="{DynamicResource Nav.Suppliers}" GroupName="ptype" Margin="0,0,18,0"
                                             IsChecked="{Binding IsClients, Converter={StaticResource InverseBool}}" />
                                <RadioButton Content="{DynamicResource Nav.Clients}" GroupName="ptype" IsChecked="{Binding IsClients}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{DynamicResource Inv.Party}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Parties}" SelectedItem="{Binding SelectedParty}" DisplayMemberPath="Name" IsEnabled="{Binding IsNormal}"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" />

                        <TextBlock Text="{DynamicResource Inv.Category}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Text"
                                  IsEditable="True" IsTextSearchEnabled="True" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Inv.Number}" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding NewNumberCommand}" Margin="4,0,0,0" Padding="8,4" ToolTip="↻" IsEnabled="{Binding IsNormal}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" />
                                    </Button>
                                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" IsReadOnly="{Binding IsRepair}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Inv.Date}" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Date}" SelectedDateFormat="Short" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                            <Setter Property="Text" Value="{DynamicResource Inv.Amount}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVat}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Inv.AmountVat}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FlowDirection="LeftToRight" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Inv.Count}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FlowDirection="LeftToRight" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding GenerateCommand}" Margin="0,18,0,0" HorizontalAlignment="Stretch" Padding="0,9"
                                Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding GenerateText}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SavedPath}" Style="{StaticResource Muted}" FontSize="11" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding OpenSavedCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Inv.Open}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportPdfCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Inv.Pdf}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowSavedCommand}" Margin="0,0,6,6" ToolTip="{DynamicResource Inv.ShowFile}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ new supplier / client ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12"
                    Visibility="{Binding IsAddingParty, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NewPartyTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding SavePartyCommand}" Padding="22,9" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Common.Save}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding CancelPartyCommand}" Content="{DynamicResource Common.Cancel}" Padding="18,9" />
                        <TextBlock Text="{Binding NewPartyError}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewPartyFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,6,12">
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                                 AcceptsReturn="{Binding IsLong}" MaxHeight="220"
                                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                        <ComboBox ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=Explicit}" svc:ComboSearch.IsEnabled="True" HorizontalAlignment="Stretch"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ preview ============ -->
            <Grid Grid.Column="2" Visibility="{Binding IsAddingParty, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Inv.PartyDetails}" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Text="{Binding PartyDetails}" TextWrapping="Wrap" MaxHeight="120" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Inv.Edit}" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,6" />
                        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32" SelectionUnit="Cell">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       ToolTip="{DynamicResource Rep.Locked}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{StaticResource Inv.Code}" Binding="{Binding Code}" Width="110" />
                                <DataGridTextColumn Header="{StaticResource Inv.Desc}" Binding="{Binding Description}" Width="*" MinWidth="220" />
                                <DataGridTextColumn Header="{StaticResource Inv.Qty}" Binding="{Binding Quantity}" Width="70" />
                                <DataGridTextColumn Header="{StaticResource Inv.Price}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110" />
                                <DataGridTextColumn Header="{StaticResource Inv.LineAmount}" Binding="{Binding Amount, Mode=OneWay, StringFormat=N2}" Width="130" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" VerticalAlignment="Center" Padding="22,10" Margin="12,0,0,0"
                                Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding HasLines}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Inv.Save}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,26,4" Visibility="{Binding HasVat, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Inv.Net}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding NetText}" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,26,4" Visibility="{Binding HasVat, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Inv.Vat}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding VatText}" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,26,4">
                                    <TextBlock Text="{DynamicResource Inv.Total}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,26,4">
                                    <TextBlock Text="{DynamicResource Inv.Diff}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding DifferenceText}" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBalanced}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding Words}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
