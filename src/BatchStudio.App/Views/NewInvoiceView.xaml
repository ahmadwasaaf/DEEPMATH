<UserControl x:Class="BatchStudio.App.Views.NewInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:BatchStudio.App.Services"
             xmlns:vm="clr-namespace:BatchStudio.App.ViewModels"
             xmlns:local="clr-namespace:BatchStudio.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
<DataTemplate x:Key="ThemeFieldTemplate">
                                    <StackPanel Margin="0,0,6,12">
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4">
                                            <Run Text="{Binding Caption, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Note, Mode=OneWay}" />
                                        </TextBlock>
                                        <DockPanel IsEnabled="{Binding Supported}">
                                            <Button DockPanel.Dock="Right" Command="{Binding PickCommand}" Margin="8,0,0,0" Padding="0" Width="64" MinHeight="38"
                                                    ToolTip="{DynamicResource Theme.Pick}">
                                                <Grid Width="60" Height="26">
                                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding Swatch}" />
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasColor, Converter={StaticResource InverseBoolToVis}}" />
                                                </Grid>
                                            </Button>
                                            <Grid>
                                                <TextBox x:Name="ThemeHex" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="11,0,11,0" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="14"
                                                         VerticalContentAlignment="Center" LostFocus="OnThemeLostFocus" KeyDown="OnThemeKeyDown" />
                                                <TextBlock Text="Not Assigned Yet" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5" FlowDirection="LeftToRight">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=ThemeHex}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
        <!-- one field of the supplier / client (new form and details panel); grows with its lines (Alt+Enter) -->
        <DataTemplate x:Key="PartyFieldTemplate" DataType="{x:Type vm:NewFieldViewModel}">
            <StackPanel Margin="0,0,6,12">
                <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="11,9,11,9"
                         AcceptsReturn="{Binding IsLong}" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                <ComboBox ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=Explicit}" svc:ComboSearch.IsEnabled="True" HorizontalAlignment="Stretch" MinHeight="38" VerticalContentAlignment="Center"
                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="MidLeftCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="MidLeftEdit" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CenterEdit" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- centred column title: the header itself is centred from code (keeps the Fluent header look) -->
        <DataTemplate x:Key="CenterHeader">
            <TextBlock Text="{Binding}" Loaded="OnCenterHeaderLoaded" />
        </DataTemplate>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NewInvoiceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Inv.New}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="22" Margin="0,0,12,0" />
                <TextBlock Text="{DynamicResource Nav.NewInvoice}" Style="{StaticResource PageTitle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ form ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Smart Invoice Repair banner -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Background="#33F2A93B" BorderBrush="#F2A93B" BorderThickness="1"
                                Visibility="{Binding IsRepair, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding CancelRepairCommand}" Padding="8,3" VerticalAlignment="Top" ToolTip="{DynamicResource Rep.Cancel}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="SMART INVOICE REPAIR" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding RepairInfo}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Inv.Template}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" IsEnabled="{Binding IsNormal}" />
                        <TextBlock Text="{Binding TemplateInfo}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />

                        <!-- "Invoice for" + supplier / client; the bank pager sits right above "Clients" -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Inv.PartyType}" Style="{StaticResource FieldLabel}" />
                            <!-- bank account printed on this invoice: lights up when the supplier has more than one -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,6,0,2"
                                        FlowDirection="LeftToRight" ToolTip="{Binding BankTip}" ToolTipService.ShowOnDisabled="True"
                                        Visibility="{Binding ShowBankPager, Converter={StaticResource BoolToVis}}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0.4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasManyBanks}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Command="{Binding PrevBankCommand}" Width="26" Padding="0,1" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" Margin="-26,0,0,0"
                                        Visibility="{Binding CanPrevBank, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Bank.Prev}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" />
                                </Button>
                                <TextBlock Text="{Binding BankLabel}" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasManyBanks}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Command="{Binding NextBankCommand}" Width="26" Padding="0,1" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                        Visibility="{Binding CanNextBank, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Bank.Next}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <RadioButton Grid.Row="1" Grid.Column="0" Content="{DynamicResource Nav.Suppliers}" GroupName="ptype" Margin="0,0,18,0"
                                         IsChecked="{Binding IsClients, Converter={StaticResource InverseBool}}" IsEnabled="{Binding IsNormal}" />
                            <RadioButton Grid.Row="1" Grid.Column="1" Content="{DynamicResource Nav.Clients}" GroupName="ptype" IsChecked="{Binding IsClients}"
                                         IsEnabled="{Binding IsNormal}" />
                            <Button Grid.Row="1" Grid.Column="3" Command="{Binding AddPartyCommand}" Padding="9,5" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Inv.AddParty}" Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding IsNormal}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                            </Button>
                        </Grid>

                        <TextBlock Text="{DynamicResource Inv.Party}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Parties}" SelectedItem="{Binding SelectedParty}" TextSearch.TextPath="Name" IsEnabled="{Binding IsNormal}"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True">
                            <!-- the supplier's number of bank accounts on the right of its name (2 and more) -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BankBadgeBorder}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=Badge}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="Badge" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource BankBadge}">
                                                        <Binding />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Inv.Category}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Text"
                                  IsEditable="True" IsTextSearchEnabled="True" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Inv.Number}" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding NewNumberCommand}" Margin="4,0,0,0" Padding="8,4" ToolTip="↻" IsEnabled="{Binding IsNormal}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" />
                                    </Button>
                                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" IsReadOnly="{Binding IsRepair}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Inv.Date}" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Date}" SelectedDateFormat="Short" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                            <Setter Property="Text" Value="{DynamicResource Inv.Amount}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVat}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Inv.AmountVat}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FlowDirection="LeftToRight" LostFocus="OnAmountLostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Inv.Count}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FlowDirection="LeftToRight" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding GenerateCommand}" Margin="0,18,0,0" HorizontalAlignment="Stretch" Padding="0,9"
                                Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding GenerateText}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SavedPath}" Style="{StaticResource Muted}" FontSize="11" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding OpenSavedCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Inv.Open}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportPdfCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Inv.Pdf}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowSavedCommand}" Margin="0,0,6,6" ToolTip="{DynamicResource Inv.ShowFile}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ new supplier / client ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12"
                    Visibility="{Binding IsAddingParty, Converter={StaticResource BoolToVis}}">
                <local:PartyFormView DataContext="{Binding PartyForm}" />
            </Border>

            <!-- ============ preview ============ -->
            <Grid Grid.Column="2" Visibility="{Binding IsAddingParty, Converter={StaticResource InverseBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- party: name / native name / category; the arrow opens every field for review and editing -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="DetailsToggle" DockPanel.Dock="Right" Command="{Binding ToggleDetailsCommand}" VerticalAlignment="Top" Padding="8,6"
                                    Visibility="{Binding CanEditParty, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Inv.AllDetails}">
                                <TextBlock FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="&#xE70E;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="{Binding PartyDetails}" TextWrapping="Wrap" MaxHeight="80" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Inv.Edit}" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,6" />
                        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32" SelectionUnit="Cell">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       ToolTip="{DynamicResource Rep.Locked}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{StaticResource Inv.Code}" HeaderTemplate="{StaticResource CenterHeader}" ElementStyle="{StaticResource CenterCell}" Binding="{Binding Code}" Width="110" />
                                <DataGridTextColumn Header="{StaticResource Inv.Desc}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding Description}" Width="*" MinWidth="220"
                                                    ElementStyle="{StaticResource MidLeftCell}" EditingElementStyle="{StaticResource MidLeftEdit}" />
                                <DataGridTextColumn Header="{StaticResource Inv.Qty}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding Quantity}" Width="80"
                                                    ElementStyle="{StaticResource CenterCell}" EditingElementStyle="{StaticResource CenterEdit}" />
                                <DataGridTextColumn Header="{StaticResource Inv.Price}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120"
                                                    ElementStyle="{StaticResource CenterCell}" EditingElementStyle="{StaticResource CenterEdit}" />
                                <DataGridTextColumn Header="{StaticResource Inv.LineAmount}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding Amount, Mode=OneWay, StringFormat=N2}" Width="140" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CenterCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>


                <!-- expanded party details float over the items, down to the totals (the items do not move) -->
                <Border Grid.Row="1" Panel.ZIndex="10" Margin="0,-6,0,0" CornerRadius="8" Padding="14,10,8,10"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" x:Name="PartyOverlay">
                    <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DetailsExpanded}" Value="True" />
                                                <Condition Binding="{Binding CanEditParty}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding PartyFields}" Focusable="False">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:NewFieldViewModel}">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PartyFieldTemplate}" Focusable="False" />
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                                <!-- supplier theme (same field as in Suppliers details) -->
                                <ContentControl Content="{Binding PartyTheme}" ContentTemplate="{StaticResource ThemeFieldTemplate}" Focusable="False" />
                            </StackPanel>
                            </ScrollViewer>
                        <Button Grid.Row="1" Command="{Binding SavePartyDetailsCommand}" HorizontalAlignment="Right" Margin="0,6,6,0" Padding="16,7"
                                    Style="{DynamicResource AccentButtonStyle}" Visibility="{Binding PartyDirty, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Common.Save}" />
                                </StackPanel>
                            </Button>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" VerticalAlignment="Center" Padding="22,10" Margin="12,0,0,0"
                                Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding HasLines}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Inv.Save}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,26,4" Visibility="{Binding HasVat, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Inv.Net}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding NetText}" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,26,4" Visibility="{Binding HasVat, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Inv.Vat}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding VatText}" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,26,4">
                                    <TextBlock Text="{DynamicResource Inv.Total}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,26,4">
                                    <TextBlock Text="{DynamicResource Inv.Diff}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding DifferenceText}" FontSize="15" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBalanced}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding Words}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
