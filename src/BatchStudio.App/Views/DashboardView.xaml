<UserControl x:Class="BatchStudio.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- centred column title: the header itself is centred from code (keeps the Fluent header look) -->
        <DataTemplate x:Key="CenterHeader">
            <TextBlock Text="{Binding}" Loaded="OnCenterHeaderLoaded" />
        </DataTemplate>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header band -->
        <Border Grid.Row="0" CornerRadius="8" Padding="20,14" Margin="0,0,0,12" Background="#1F2D46">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding OpenExcelCommand}" VerticalAlignment="Center" ToolTip="{DynamicResource Dash.OpenExcel}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" />
                </Button>
                <TextBlock Text="{DynamicResource Dash.Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- filters + search -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{DynamicResource Dash.Period}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="150" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Hist.From}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding From}" Width="135" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource Hist.To}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding To}" Width="135" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{DynamicResource Dash.Mode}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="125" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{DynamicResource Dash.Ranking}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Rankings}" SelectedItem="{Binding Ranking}" Width="90" />
                </StackPanel>
                <Button Command="{Binding ExportPdfCommand}" Margin="0,0,16,6" VerticalAlignment="Center" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,8,0" Foreground="White" />
                        <TextBlock Text="{DynamicResource Dash.ExportPdf}" Foreground="White" />
                    </StackPanel>
                </Button>
                <Grid Width="280" Margin="0,0,0,6">
                    <TextBox x:Name="Search" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="30,6,8,6" VerticalContentAlignment="Center" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left" Opacity="0.7" />
                    <TextBlock Text="{DynamicResource Dash.Search}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup IsOpen="{Binding HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=Search}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" Width="280">
                        <Border Style="{StaticResource Card}" Padding="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                            <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" MaxHeight="300" BorderThickness="0" />
                        </Border>
                    </Popup>
                </Grid>
            </WrapPanel>
        </Border>

        <!-- KPI tiles -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash.Total}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource KpiValue}" Margin="0,6,0,0" />
                    <TextBlock Text="USD" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding SuppliersText}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding SuppliersTotalText}" Style="{StaticResource KpiValue}" Margin="0,6,0,0" />
                    <TextBlock Text="{DynamicResource Dash.Suppliers}" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding ClientsText}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding ClientsTotalText}" Style="{StaticResource KpiValue}" Margin="0,6,0,0" />
                    <TextBlock Text="{DynamicResource Dash.Clients}" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash.Invoices}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding InvoicesText}" Style="{StaticResource KpiValue}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ranking -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding RankingTitle}" Style="{StaticResource SectionTitle}" Margin="6,2,0,8" />
                <DataGrid x:Name="RankGrid" PreviewMouseRightButtonDown="OnRowRightClick" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40" SelectionMode="Single">
                    <!-- right-click on a row: the same two choices as its Actions list -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Tag="report" Header="{DynamicResource Act.ViewReport}" Click="OnMenuAction" />
                            <MenuItem Tag="exportreport" Header="{DynamicResource Act.ExportReport}" Click="OnMenuAction" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                        <Style x:Key="Mid" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                        <Style x:Key="MidCenter" TargetType="TextBlock" BasedOn="{StaticResource Mid}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{StaticResource Col.Rank}" Width="Auto" MinWidth="64" SortMemberPath="Row.Rank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RankText}" Style="{StaticResource PartyLink}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.OpenPartyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Company}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding Name}" Width="*" MinWidth="180" />
                        <DataGridTemplateColumn Header="{StaticResource Col.Amount}" HeaderTemplate="{StaticResource CenterHeader}" Width="170" SortMemberPath="Amount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Amount, StringFormat=N2}" />
                                        <ProgressBar Value="{Binding Bar, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" MinHeight="4" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource MidCenter}" Header="{StaticResource Col.InvCount}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding Count}" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Type}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding Type}" Width="Auto" MinWidth="90" />
                        <DataGridTextColumn ElementStyle="{StaticResource Mid}" Header="{StaticResource Col.Category}" HeaderTemplate="{StaticResource CenterHeader}" Binding="{Binding Category}" Width="Auto" MinWidth="120" />
                        <DataGridTemplateColumn Header="{StaticResource Col.Actions}" HeaderTemplate="{StaticResource CenterHeader}" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- centred in the column -->
                                    <Grid Width="160" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ComboBox x:Name="Act" SelectionChanged="OnActionChosen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="28" Padding="10,3">
                                            <ComboBoxItem Tag="report" Content="{DynamicResource Act.ViewReport}" />
                                            <ComboBoxItem Tag="exportreport" Content="{DynamicResource Act.ExportReport}" />
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource Col.Actions}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,22,0" Opacity="0.75">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=Act}" Value="-1">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="120" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
