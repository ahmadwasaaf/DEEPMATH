<UserControl x:Class="BatchStudio.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:BatchStudio.App.Services">
    <UserControl.Resources>
        <svc:ShortIdConverter x:Key="ShortId" />
        <!-- list text centred in its row, like the Suppliers list -->
        <Style x:Key="ListCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Reports.Title}" Style="{StaticResource PageTitle}" />
            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="10,2" Margin="12,4,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}" />
            </Border>
        </StackPanel>

        <!-- toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="170" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" Width="170" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Border Width="1" Margin="4,6,12,6" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Button Command="{Binding ViewReportCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Act.ViewReportShort}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportReportCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Act.ExportReportShort}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border x:Name="SearchHost" Grid.Column="1" Margin="8,0,0,0">
                <Grid x:Name="SearchBox" HorizontalAlignment="Right" Width="300">
                    <TextBox x:Name="Search" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="30,6,8,6" VerticalContentAlignment="Center" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.7" />
                    <TextBlock Text="{DynamicResource Common.Search}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- list + report -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="330" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <GridSplitter x:Name="ListSplitter" Grid.Column="1" Style="{StaticResource ListSplitter}" ToolTip="{DynamicResource Common.DragWidth}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" SelectionMode="Single"
                          MouseDoubleClick="OnRowDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id, Converter={StaticResource ShortId}}" Width="Auto" MinWidth="60" ElementStyle="{StaticResource ListCell}" />
                        <DataGridTextColumn Header="{StaticResource Col.Company}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource ListCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <ContentControl Grid.Column="2" Content="{Binding Report}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}" />
            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding NoReport, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="40" HorizontalAlignment="Center" Opacity="0.5" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Reports.Hint}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="120" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
