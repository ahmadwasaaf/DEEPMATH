<UserControl x:Class="BatchStudio.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Home.Welcome}" FontSize="14" />
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding EntityName}" FontSize="32" />

            <Border Style="{StaticResource Card}" Margin="0,12,0,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ChangeFolderCommand}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Set.ChangeFolder}" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding OpenWorkbookCommand}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Home.OpenWorkbook}" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding OpenDatabaseCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Common.OpenFolder}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="22" Margin="0,0,14,0" Foreground="{StaticResource BrandBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Home.Database}" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Text="{Binding DatabasePath}" FontSize="14" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="210" Height="118" Margin="0,0,14,14">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Right" Opacity="0.6" />
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="13" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,6,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{StaticResource WarnBrush}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home.Missing}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Missing}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{DynamicResource Home.Repair}" Command="{Binding RepairCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
