<UserControl x:Class="BatchStudio.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BatchStudio.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- a Google account picture: the photo, or the first letter on the accent colour -->
        <DataTemplate x:Key="AvatarTemplate">
            <Grid>
                <Ellipse Fill="{DynamicResource BrandBrush}" />
                <Viewbox>
                    <Border Width="40" Height="40">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Viewbox>
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BannerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>

            <!-- ========== header: name + news ticker + lock-screen clock ========== -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- the user: Google photo (or the initial); signed out, a click leads to Settings › Sign in with Google -->
                    <Button x:Name="AvatarButton" Command="{Binding OpenAccountCommand}" Cursor="Hand" Margin="0,0,18,0" VerticalAlignment="Center" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="Root" Width="68" Height="68" Background="Transparent">
                                    <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="{DynamicResource BrandBrush}" Opacity="0.85" />
                                    <Grid Margin="5">
                                        <Ellipse Fill="{DynamicResource BrandSoftBrush}" />
                                        <TextBlock x:Name="Person" Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="24" Foreground="{DynamicResource BrandBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse x:Name="InitialBack" Fill="{DynamicResource BrandBrush}" Visibility="Collapsed" />
                                        <TextBlock x:Name="Initial" Text="{Binding Account.Initial}" Foreground="White" FontSize="24" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Account.Avatar}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Account.IsSignedIn}" Value="True">
                                        <Setter TargetName="Person" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="InitialBack" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Initial" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Account.IsSignedIn}" Value="False">
                                        <Setter TargetName="Ring" Property="StrokeDashArray" Value="3 2" />
                                        <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                        <Setter TargetName="Ring" Property="StrokeThickness" Value="3" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Account.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Account.Email}" Opacity="0.75" />
                                    <TextBlock Text="{DynamicResource Home.SignInHint}">
                                        <TextBlock.Visibility>
                                            <Binding Path="Account.IsSignedIn" Converter="{StaticResource InverseBoolToVis}" />
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <!-- account menu (like Google's): the account in use, the other accounts, add / sign out -->
                    <Popup IsOpen="{Binding AccountMenuOpen, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=AvatarButton}"
                           Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="360" Margin="12" CornerRadius="16" BorderThickness="1" Padding="10"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Direction="270" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- in use -->
                                <Border CornerRadius="12" Padding="14" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding Account.IsSignedIn, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <ContentControl Width="52" Height="52" Content="{Binding Account}" ContentTemplate="{StaticResource AvatarTemplate}" Margin="0,0,14,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Account.Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Account.Email}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- the other accounts: a click switches; signed out ones offer Sign in / Remove -->
                                <ItemsControl ItemsSource="{Binding Account.Others}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <Button Style="{StaticResource MenuRow}" Padding="10,8"
                                                        Command="{Binding DataContext.Account.SwitchToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                                Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVis}}">
                                                            <TextBlock Text="{DynamicResource Google.SignedOut}" FontSize="11" Style="{StaticResource Muted}" />
                                                        </Border>
                                                        <ContentControl Width="34" Height="34" Content="{Binding}" ContentTemplate="{StaticResource AvatarTemplate}" Margin="0,0,12,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Email}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Margin="56,4,0,6"
                                                            Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVis}}">
                                                    <Button Content="{DynamicResource Google.SignInShort}" MinWidth="90" Style="{DynamicResource AccentButtonStyle}"
                                                            Command="{Binding DataContext.Account.SignInAgainCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="{DynamicResource Google.Remove}" MinWidth="90" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.Account.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Margin="4,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Button Style="{StaticResource MenuRow}" Padding="12,9" Command="{Binding Account.AddAccountCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" FontSize="15" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Google.AddAccount}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRow}" Padding="12,9" Command="{Binding OpenSettingsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Google.Manage}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuRow}" Padding="12,9" Command="{Binding Account.SignOutCommand}"
                                        Visibility="{Binding Account.IsSignedIn, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xF3B1;" FontSize="15" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Google.SignOut}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Home.Welcome}" FontSize="14" />
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding EntityName}" FontSize="32" />
                    </StackPanel>
                </StackPanel>

                <!-- lock-screen clock; the connection (Wi-Fi arcs: white online, amber with no internet, crossed offline) on its left,
                     level with the date -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0">
                    <Border Background="Transparent" Margin="0,0,14,1" VerticalAlignment="Bottom" ToolTip="{Binding Net.Tip}">
                    <Viewbox Width="26" Height="21">
                        <Canvas Width="24" Height="19">
                            <Canvas.Resources>
                                <Style TargetType="Path">
                                    <Setter Property="StrokeThickness" Value="2.3" />
                                    <Setter Property="StrokeStartLineCap" Value="Round" />
                                    <Setter Property="StrokeEndLineCap" Value="Round" />
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Net.IsLimited}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Net.IsOffline}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Canvas.Resources>
                            <Path Data="M2.45,7.45 A13.5,13.5 0 0 1 21.55,7.45" />
                            <Path Data="M5.64,10.64 A9,9 0 0 1 18.36,10.64" />
                            <Path Data="M8.82,13.82 A4.5,4.5 0 0 1 15.18,13.82" />
                            <Path Data="M12,16.9 L12,17" StrokeThickness="3.6" />
                            <!-- offline: crossed out -->
                            <Line X1="3" Y1="1.5" X2="21" Y2="18" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{StaticResource BadBrush}" Visibility="{Binding Net.IsOffline, Converter={StaticResource BoolToVis}}" />
                        </Canvas>
                    </Viewbox>
                    </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                        <TextBlock x:Name="ClockTime" Text="00:00" FontSize="58" FontWeight="Light" FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <StackPanel Margin="8,0,0,12" VerticalAlignment="Bottom">
                            <TextBlock x:Name="ClockAmPm" Text="AM" FontSize="15" FontWeight="SemiBold" Opacity="0.75" />
                            <TextBlock x:Name="ClockSeconds" Text="00" FontSize="18" FontWeight="Light" Opacity="0.6" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ClockDate" Text="" FontSize="15" HorizontalAlignment="Center" Opacity="0.9" Margin="0,-4,0,0" />
                </StackPanel>
                </StackPanel>
            </Grid>

            <!-- business pulse: live indicators -->
            <Border CornerRadius="12" Padding="18,12" Margin="0,12,0,18"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="9" Padding="8,2" BorderThickness="1"
                            BorderBrush="{StaticResource GoodBrush}">
                        <Border.Background>
                            <SolidColorBrush Color="#2EA043" Opacity="0.14" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource GoodBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="LIVE" Foreground="{StaticResource GoodBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{DynamicResource Home.Pulse}" FontSize="12" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13" Foreground="{StaticResource GoodBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.Resources>
                        <Style x:Key="PulseLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,14,0" />
                        </Style>
                        <Style x:Key="PulseValue" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <!-- companies: the wide side -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Home.PulseTopSupplier}" Style="{StaticResource PulseLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PulseTopSupplier}" ToolTip="{Binding PulseTopSupplierTip}" Style="{StaticResource PulseValue}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Home.PulseTopClient}" Style="{StaticResource PulseLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PulseTopClient}" ToolTip="{Binding PulseTopClientTip}" Style="{StaticResource PulseValue}" />
                    <!-- total transactions: label on top, the value large -->
                    <Border Grid.RowSpan="2" Grid.Column="2" Width="1" Margin="20,2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <StackPanel Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Center" MinWidth="170" Margin="0,0,44,0">
                        <TextBlock Text="{DynamicResource Home.PulseValue}" Style="{StaticResource PulseLabel}" Margin="0,0,0,2" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding PulseTotal}" ToolTip="{Binding PulseTotalTip}" FontSize="30" FontWeight="SemiBold"
                                   FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>

        </StackPanel>

        <!-- ========== cards over a calm particle network ========== -->
        <Grid Grid.Row="1" x:Name="ParticleArea" Background="Transparent" Margin="-28,0,-28,-20"
              MouseMove="OnParticleAreaMouseMove" MouseLeave="OnParticleAreaMouseLeave">
            <ctl:ParticleNetwork x:Name="Particles" Tint="{DynamicResource TextFillColorPrimaryBrush}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="28,0,28,20">
                <StackPanel>
            <!-- ========== stat cards ========== -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- solid base: the particles pass behind the cards, not through them -->
<Border Width="210" Height="132" Margin="0,0,14,14" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
<Border Style="{StaticResource Card}">
                            <Grid>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" CornerRadius="10" Margin="0,-4,-4,0"
                                        Background="{DynamicResource BrandSoftBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource BrandBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Value}" FontSize="32" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
</Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,6,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{StaticResource WarnBrush}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home.Missing}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Missing}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{DynamicResource Home.Repair}" Command="{Binding RepairCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========== Gmail: the newest emails (sender + subject); a click opens the message in Gmail ========== -->
        <Border Grid.Row="2" x:Name="MailBanner" Margin="0,14,0,0" CornerRadius="14" BorderThickness="1" ClipToBounds="True"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Visibility="{Binding Mail.ShowBanner, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BannerShift" />
            </Border.RenderTransform>
            <Grid Background="{DynamicResource SubtleFillColorSecondaryBrush}" MinHeight="78">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- accent edge -->
                <Border Background="{DynamicResource BrandBrush}" />

                <!-- envelope + unread count -->
                <Grid Grid.Column="1" Width="48" Height="48" Margin="18,0,16,0" VerticalAlignment="Center">
                    <Ellipse x:Name="MailGlow" Fill="{DynamicResource BrandBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="MailGlowScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Fill="{DynamicResource BrandSoftBrush}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" FontSize="20" Foreground="{DynamicResource BrandBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0" MinWidth="20" Height="20" CornerRadius="10" Padding="5,0"
                            Background="{StaticResource BadBrush}" BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mail.Unread}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Mail.Unread}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- the message: a click opens it in Gmail -->
                <Grid Grid.Column="2" Background="Transparent" Cursor="Hand" Margin="0,12,8,12" ToolTip="{DynamicResource Mail.Open}">
                    <Grid.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding Mail.OpenCommand}" />
                    </Grid.InputBindings>
                    <!-- newest emails -->
                    <StackPanel x:Name="MailText" VerticalAlignment="Center" Visibility="{Binding Mail.HasItems, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Mail.UnreadText}" Style="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Mail.Current.From}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                <TextBlock Text="  ·  " Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Mail.Current.Time}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Mail.Current.Subject}" FontSize="16" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- nothing new -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel.Visibility>
                            <Binding Path="Mail.HasItems" Converter="{StaticResource InverseBoolToVis}" />
                        </StackPanel.Visibility>
                        <TextBlock Text="{Binding Account.Email}" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Text="{Binding Mail.UnreadText}" FontSize="16" Margin="0,3,0,0">
                            <TextBlock.Visibility>
                                <Binding Path="Mail.HasProblem" Converter="{StaticResource InverseBoolToVis}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- why the inbox cannot be read (Gmail not allowed, no answer ...) -->
                        <TextBlock Text="{Binding Mail.Problem}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                                   Visibility="{Binding Mail.HasProblem, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>

                <!-- 1 / 3, previous / next, hide -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Mail.HasMany, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding Mail.PreviousCommand}" Padding="8,6" ToolTip="{DynamicResource Mail.Previous}" Style="{StaticResource BannerButton}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" />
                        </Button>
                        <TextBlock Text="{Binding Mail.Position}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="6,0"
                                   FlowDirection="LeftToRight" MinWidth="34" TextAlignment="Center" />
                        <Button Command="{Binding Mail.NextCommand}" Padding="8,6" ToolTip="{DynamicResource Mail.Next}" Style="{StaticResource BannerButton}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <Button Command="{Binding Mail.DismissCommand}" Padding="8,6" Margin="6,0,0,0" ToolTip="{DynamicResource Mail.Hide}" Style="{StaticResource BannerButton}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
