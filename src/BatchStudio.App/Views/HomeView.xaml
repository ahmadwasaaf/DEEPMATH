<UserControl x:Class="BatchStudio.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ========== header: name + news ticker + lock-screen clock ========== -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Home.Welcome}" FontSize="14" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding EntityName}" FontSize="32" />
                </StackPanel>

                <!-- lock-screen clock -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                        <TextBlock x:Name="ClockTime" Text="00:00" FontSize="58" FontWeight="Light" FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock x:Name="ClockSeconds" Text="00" FontSize="20" FontWeight="Light" Opacity="0.6" Margin="6,0,0,12" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="ClockDate" Text="" FontSize="14" HorizontalAlignment="Center" Style="{StaticResource Muted}" Margin="0,-6,0,0" />
                </StackPanel>
            </Grid>

            <!-- business pulse: live indicators -->
            <Border CornerRadius="12" Padding="18,12" Margin="0,12,0,18"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="9" Padding="8,2" BorderThickness="1"
                            BorderBrush="{StaticResource GoodBrush}">
                        <Border.Background>
                            <SolidColorBrush Color="#2EA043" Opacity="0.14" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource GoodBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="LIVE" Foreground="{StaticResource GoodBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{DynamicResource Home.Pulse}" FontSize="12" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13" Foreground="{StaticResource GoodBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.Resources>
                        <Style x:Key="PulseLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,14,0" />
                        </Style>
                        <Style x:Key="PulseValue" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <!-- companies: the wide side -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Home.PulseTopSupplier}" Style="{StaticResource PulseLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PulseTopSupplier}" ToolTip="{Binding PulseTopSupplierTip}" Style="{StaticResource PulseValue}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Home.PulseTopClient}" Style="{StaticResource PulseLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PulseTopClient}" ToolTip="{Binding PulseTopClientTip}" Style="{StaticResource PulseValue}" />
                    <!-- totals -->
                    <Border Grid.RowSpan="2" Grid.Column="2" Width="1" Margin="20,2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Home.PulseInvoices}" Style="{StaticResource PulseLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding PulseInvoices}" Style="{StaticResource PulseValue}" FlowDirection="LeftToRight" HorizontalAlignment="Right" MinWidth="90" TextAlignment="Right" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource Home.PulseValue}" Style="{StaticResource PulseLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding PulseTotal}" ToolTip="{Binding PulseTotalTip}" Style="{StaticResource PulseValue}" FlowDirection="LeftToRight" HorizontalAlignment="Right" MinWidth="90" TextAlignment="Right" />
                </Grid>
                </Grid>
            </Border>

            <!-- ========== stat cards ========== -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="210" Height="132" Margin="0,0,14,14">
                            <Grid>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" CornerRadius="10" Margin="0,-4,-4,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2F80ED" Opacity="0.16" />
                                    </Border.Background>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" Foreground="{StaticResource BrandBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Value}" FontSize="32" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,6,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{StaticResource WarnBrush}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home.Missing}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Missing}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{DynamicResource Home.Repair}" Command="{Binding RepairCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
