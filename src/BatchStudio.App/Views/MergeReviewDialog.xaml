<Window x:Class="BatchStudio.App.Views.MergeReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="860" MaxHeight="720" SizeToContent="Height" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI">
    <Border Margin="16" CornerRadius="14" Padding="22,18" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" /></Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource BrandSoftBrush}" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="16" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
                <TextBlock x:Name="SubText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{DynamicResource Common.Cancel}" Padding="16,7" Margin="0,0,8,0" Click="OnCancel" />
                <Button x:Name="OkBtn" Style="{DynamicResource AccentButtonStyle}" Padding="18,7" Click="OnOk">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock x:Name="OkText" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource MergeReview.Field}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{DynamicResource MergeReview.Saved}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="{DynamicResource MergeReview.Incoming}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="10,0,0,0" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,8,8,0" />
                                <!-- kept (default) -->
                                <RadioButton Grid.Column="1" GroupName="{Binding Group}" IsChecked="{Binding KeepSaved}" Margin="10,0,4,0" Cursor="Hand"
                                             VerticalContentAlignment="Top">
                                    <Border CornerRadius="8" Padding="10,7" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding SavedText}" TextWrapping="Wrap" FontSize="12" />
                                    </Border>
                                </RadioButton>
                                <RadioButton Grid.Column="2" GroupName="{Binding Group}" IsChecked="{Binding TakeIncoming}" Margin="10,0,0,0" Cursor="Hand"
                                             VerticalContentAlignment="Top">
                                    <Border CornerRadius="8" Padding="10,7" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <TextBlock Text="{Binding IncomingText}" TextWrapping="Wrap" FontSize="12" />
                                    </Border>
                                </RadioButton>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
